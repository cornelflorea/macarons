---
import Layout from '../layouts/Layout.astro';

const macarons = [
  { name: 'Pistacho', color: '#a8c98f', description: 'Cremoso y tostado, con pistachos de verdad en el relleno.' },
  { name: 'Frambuesa', color: '#e0507a', description: 'Ganache de frambuesa, dulce con un toque ácido.' },
  { name: 'Chocolate', color: '#6b4333', description: 'Ganache intenso de chocolate negro.' },
  { name: 'Vainilla', color: '#f3dd9b', description: 'Crema suave de vainilla, el clásico de siempre.' },
];

const sweets = [
  { name: 'Tiramisú', color: '#c9a27e', description: 'Receta italiana de mascarpone y café.' },
  { name: 'Pavlova', color: '#f7c8d2', description: 'Merengue crujiente con nata y fruta fresca.' },
];

const boxes = [
  { name: 'Caja de 6', price: '20 €' },
  { name: 'Caja de 12', price: '40 €' },
];
---
<Layout title="Menú | Dulce Macaron by Diana">
  <h1>Menú</h1>

  <h2>Macarons</h2>
  <p>4 € la unidad.</p>
  <div class="cards">
    {macarons.map((item) => (
      <article class="card">
        <div class="swatch" style={`background: ${item.color}`}></div>
        <h3>{item.name}</h3>
        <p class="description">{item.description}</p>
        <p class="price">4 €</p>
      </article>
    ))}
  </div>

  <h3 class="boxes-title">Cajas</h3>
  <div class="boxes">
    {boxes.map((box) => (
      <div class="box">
        <span>{box.name}</span>
        <strong>{box.price}</strong>
      </div>
    ))}
  </div>

  <h2>Otros dulces</h2>
  <div class="cards">
    {sweets.map((item) => (
      <article class="card">
        <div class="swatch" style={`background: ${item.color}`}></div>
        <h3>{item.name}</h3>
        <p class="description">{item.description}</p>
        <p class="on-demand">Bajo pedido</p>
      </article>
    ))}
  </div>
  <p>Estos dulces se preparan solo bajo pedido. <a href="/contact">Contáctanos</a> para consultar disponibilidad y precio.</p>
</Layout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--vanilla-deep);
    border-radius: 20px;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 6px 18px rgba(139, 42, 71, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 26px rgba(139, 42, 71, 0.15);
  }
  .swatch {
    width: 84px;
    height: 84px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    box-shadow: inset 0 -8px 14px rgba(0, 0, 0, 0.12), 0 4px 10px rgba(0, 0, 0, 0.12);
  }
  .card h3 {
    font-family: var(--font-heading);
    margin: 0 0 0.5rem;
    color: var(--cocoa);
  }
  .description {
    flex: 1;
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  .price {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--raspberry);
  }
  .on-demand {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pistachio-dark);
  }
  .boxes-title {
    font-family: var(--font-heading);
    margin: 0 0 1rem;
  }
  .boxes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .box {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.75rem 1.5rem;
    border-radius: 999px;
    background: var(--vanilla-deep);
  }
  .box strong {
    color: var(--raspberry);
    font-size: 1.2rem;
  }
  a {
    color: var(--raspberry);
  }
</style>
