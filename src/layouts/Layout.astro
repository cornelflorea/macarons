---
const { title } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/logo-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="brand"><img src="/logo.svg" alt="" width="44" height="23" />Dulce Macaron</a>
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span><span></span>
      </button>
      <nav id="site-nav">
        <a href="/" class:list={[{ active: Astro.url.pathname === '/' }]}>Inicio</a>
        <a href="/gallery" class:list={[{ active: Astro.url.pathname === '/gallery' }]}>Galería</a>
        <a href="/menu" class:list={[{ active: Astro.url.pathname === '/menu' }]}>Menú</a>
        <a href="/contact" class:list={[{ active: Astro.url.pathname === '/contact' }]}>Contacto</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href="https://instagram.com/dulce.macaron__">Instagram</a>
      <span>dulcemacaron.es@gmail.com</span>
      <span>Barcelona</span>
      <span>&copy; {new Date().getFullYear()} Dulce Macaron by Diana</span>
    </footer>
    <script>
      const toggle = document.querySelector('.menu-toggle');
      const header = document.querySelector('.site-header');
      toggle?.addEventListener('click', () => {
        const open = header?.classList.toggle('open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
      });

      // fade-in on scroll
      const targets = document.querySelectorAll<HTMLElement>(
        'main h1, main h2, main > p, .hero, .card, .box, .thumb, form, .quick, .details'
      );
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12 }
        );
        targets.forEach((el, i) => {
          // small stagger for items that appear together
          el.style.setProperty('--reveal-delay', `${(i % 4) * 80}ms`);
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --vanilla: #fff8e7;
    --vanilla-deep: #f6e7c1;
    --raspberry: #b83a5e;
    --raspberry-dark: #8b2a47;
    --pistachio: #a8c98f;
    --pistachio-dark: #6f9457;
    --cocoa: #4a3b32;
    --font-heading: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', system-ui, sans-serif;
  }
  body {
    font-family: var(--font-body);
    line-height: 1.6;
    background: var(--vanilla);
    color: var(--cocoa);
    margin: 0;
    padding: 0 1rem 2rem;
  }
  main {
    max-width: 900px;
    margin: 0 auto;
    padding-top: 2rem;
    text-align: center;
  }
  h1, h2 {
    font-family: var(--font-heading);
    color: var(--raspberry);
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 0 -1rem;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(255, 248, 231, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--vanilla-deep);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--raspberry);
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 2rem;
    font-size: 1.05rem;
  }
  nav a {
    color: inherit;
    text-decoration: none;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  nav a.active {
    border-bottom-color: var(--pistachio-dark);
    color: var(--raspberry-dark);
  }
  nav a:hover {
    color: var(--raspberry);
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--raspberry);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .site-header.open .menu-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.open .menu-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @media (max-width: 640px) {
    .menu-toggle {
      display: flex;
    }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem 1.5rem 1.5rem;
      background: var(--vanilla);
      border-bottom: 1px solid var(--vanilla-deep);
      box-shadow: 0 12px 24px rgba(139, 42, 71, 0.1);
    }
    .site-header.open nav {
      display: flex;
    }
    nav a {
      align-self: flex-start;
    }
  }
  footer {
    max-width: 900px;
    margin: 3rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid #e5d5c8;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    font-size: 0.9rem;
  }
  img {
    max-width: 100%;
    border-radius: 12px;
  }
  /* fade-in on scroll: hidden until .visible is added, then a one-off animation
     (an animation, not a transition, so hover effects on the same elements keep working) */
  .js :is(main h1, main h2, main > p, .hero, .card, .box, .thumb, form, .quick, .details):not(.visible) {
    opacity: 0;
  }
  .visible {
    animation: fade-up 0.7s ease var(--reveal-delay, 0ms) backwards;
  }
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  footer a {
    color: var(--raspberry);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  footer a:hover {
    color: var(--raspberry-dark);
    text-decoration: underline;
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>